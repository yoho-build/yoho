# Copy to .yoho/secrets and replace every value. Use long random passwords,
# for example: openssl rand -hex 32
# Or read them from a provider: MARIADB_ROOT_PASSWORD=$(op read op://Prod/mariadb/root)
MARIADB_ROOT_PASSWORD=replace-with-a-long-random-password
MARIADB_PASSWORD=replace-with-another-long-random-password
REPLICATOR_PASSWORD=replace-with-a-third-long-random-password
DEMO_WRITE_TOKEN=replace-with-a-random-token
