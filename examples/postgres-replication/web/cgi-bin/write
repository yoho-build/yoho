#!/bin/sh
# Demo only. POST /cgi-bin/write?VALUE with the DEMO_WRITE_TOKEN secret as the
# request body inserts VALUE ([A-Za-z0-9-] only) on the primary.
# shellcheck source-path=SCRIPTDIR source=common.sh
. "$(dirname "$0")/common.sh"
[ "${REQUEST_METHOD:-}" = POST ] || fail "POST the write token"
body=$(head -c "${CONTENT_LENGTH:-0}")
token=$(cat /run/secrets/DEMO_WRITE_TOKEN)
[ -n "$token" ] && [ "$body" = "$token" ] || { printf 'Status: 403 Forbidden\r\nContent-Type: text/plain\r\n\r\nforbidden\n'; exit 0; }
v=${QUERY_STRING:-}
case "$v" in ''|*[!A-Za-z0-9-]*) fail "bad value";; esac
out=$(psql -XtA -v ON_ERROR_STOP=1 -c "insert into items(v) values ('$v') returning id" 2>&1) || fail "$out"
reply "wrote $v id=$out via $PGHOST"
